# Copy this file to ".env" for local development. Every value is optional locally.
# On Vercel you set the same names in Project Settings > Environment Variables.

# --- Who the site is for (used once, to create the starter content) ---------------
OWNER_NAME=Ahmed Mohamed
# OWNER_ROLE=Full Stack Developer

# --- Admin account ----------------------------------------------------------------
# Used only the very first time the site starts (when no admin exists yet).
#   local: left empty -> a random password is generated and printed once in the terminal
#   Vercel: REQUIRED (nobody is watching the console), 12+ characters.
# You can change the password later in Admin > Settings > Account, and delete this
# variable after your first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Local development ----------------------------------------------------------
PORT=3000
# DATA_DIR=./data
# UPLOAD_DIR=./uploads

# --- Production / Vercel -----------------------------------------------------------
# These are added automatically when you connect the storage in the Vercel dashboard:
#   Upstash Redis ->  KV_REST_API_URL + KV_REST_API_TOKEN
#                     (or UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN)
#   Vercel Blob   ->  BLOB_READ_WRITE_TOKEN (or BLOB_STORE_ID with OIDC)
# If you put the Redis variables in a local .env, `npm start` will use that database
# instead of ./data — handy for testing, but remember it is the live site's data.
#
# SITE_URL=https://your-domain.com   # canonical / social-share URL (defaults to the Vercel domain)
# TRUST_PROXY=1                      # only when self-hosting behind nginx etc. (automatic on Vercel)
# HOST=0.0.0.0
